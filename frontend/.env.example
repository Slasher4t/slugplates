# URL of the SlugEats FastAPI/Playwright scraper backend.
#
# Local dev (matches the backend's default `uvicorn app.main:app --port 8000`):
VITE_API_BASE_URL=http://localhost:8000

# Production - the real, currently-deployed backend, self-hosted on a
# persistent-process server (systemd -> Uvicorn -> FastAPI -> Playwright)
# and exposed publicly over HTTPS via Tailscale Funnel:
# VITE_API_BASE_URL=https://slugeats-api.tailac5032.ts.net

# It CANNOT be a Vercel serverless function - it runs Playwright and a cold
# hall scrape can take several seconds to tens of seconds, which exceeds
# serverless execution limits. It needs a host with a persistent process
# instead (a VPS/self-hosted server, Fly.io, Railway, etc). Only this
# frontend belongs on Vercel.
#
# This project's backend previously ran on Render's free tier; that host may
# still work as a manual fallback but is no longer the primary production
# API and shouldn't be treated as current:
# VITE_API_BASE_URL=https://slugeats-api.onrender.com

# Copy this file to .env.local (gitignored) and edit there - Vite only reads
# .env.example as documentation, never as actual config.
