# URL of the SlugEats FastAPI/Playwright scraper backend.
#
# Local dev (matches the backend's default `uvicorn app.main:app --port 8000`):
VITE_API_BASE_URL=http://localhost:8000

# Production: point this at wherever that backend is actually deployed.
# It CANNOT be a Vercel serverless function - it runs Playwright and a cold
# hall scrape can take up to ~90s, which exceeds serverless execution limits.
# Use a host with a persistent process instead (Fly.io, Render, Railway, a
# VPS, etc). Only this frontend belongs on Vercel.
# VITE_API_BASE_URL=https://your-backend-host.example.com

# Copy this file to .env.local (gitignored) and edit there - Vite only reads
# .env.example as documentation, never as actual config.
